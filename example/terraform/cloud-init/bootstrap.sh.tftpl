#!/usr/bin/env bash
# shellcheck disable=SC2016 # Terraform replaces these single-quoted template expressions.
set -euo pipefail
umask 077

readonly site='${site}'
readonly expected_sha256='${artifact_sha256}'
readonly expected_revision='${artifact_revision}'

systemctl disable --now envelope.service >/dev/null 2>&1 || true
test -x /usr/local/bin/envelope
for binary in /usr/bin/awk /usr/bin/curl /usr/bin/grep /usr/bin/head /usr/bin/journalctl \
  /usr/bin/sed /usr/bin/sha256sum /usr/bin/systemctl /usr/bin/timeout /usr/sbin/ip; do
  test -x "$binary"
done
install -d -m 0755 /etc/envelope /usr/local/sbin

cat >/etc/envelope/site.env <<'SITE_ENV'
ENVELOPE_CONFIG_VERSION=${config_version}
ENVELOPE_MODE=${mode}
ENVELOPE_UDP_BIND=${udp_bind}
ENVELOPE_MAX_INNER_PACKET_SIZE=${max_inner_packet_size}
ENVELOPE_METRICS_ADDR=0.0.0.0:9090
ENVELOPE_LOG_LEVEL=info
SITE_ENV
chmod 0644 /etc/envelope/site.env

cat >/usr/local/sbin/envelope-preflight <<'PREFLIGHT'
#!/usr/bin/env bash
set -euo pipefail

readonly runtime_file=/etc/envelope/site.env
readonly artifact_file=/etc/envelope/artifact.env
readonly envelope_bin="$${ENVELOPE_BIN:-/usr/local/bin/envelope}"
readonly sha256_bin="$${SHA256_BIN:-/usr/bin/sha256sum}"

test -x "$envelope_bin"
test -r "$runtime_file"
test -r "$artifact_file"
while IFS= read -r expected; do
  grep -Fqx -- "$expected" "$runtime_file"
done <<'RUNTIME'
ENVELOPE_CONFIG_VERSION=${config_version}
ENVELOPE_MODE=${mode}
ENVELOPE_UDP_BIND=${udp_bind}
ENVELOPE_MAX_INNER_PACKET_SIZE=${max_inner_packet_size}
ENVELOPE_METRICS_ADDR=0.0.0.0:9090
ENVELOPE_LOG_LEVEL=info
RUNTIME
grep -Fqx -- 'ENVELOPE_DEPLOYED_ARTIFACT_SHA256=${artifact_sha256}' "$artifact_file"
grep -Fqx -- 'ENVELOPE_DEPLOYED_ARTIFACT_REVISION=${artifact_revision}' "$artifact_file"
printf '%s  %s\n' '${artifact_sha256}' "$envelope_bin" | "$sha256_bin" -c - >/dev/null
PREFLIGHT
chmod 0755 /usr/local/sbin/envelope-preflight

cat >/usr/local/sbin/envelope-redact <<'REDACT'
#!/usr/bin/env bash
set -euo pipefail
/usr/bin/sed -E \
  -e 's/(access[_-]?key|secret|token|auth[_-]?key)(["= :]+)[^ ,"}]+/\1\2[REDACTED]/Ig'
REDACT
chmod 0755 /usr/local/sbin/envelope-redact

cat >/usr/local/sbin/envelope-diagnostics <<'DIAGNOSTICS'
#!/usr/bin/env bash
set -euo pipefail

{
printf 'site=%s run=%s\n' '${site}' '${run_name}'
printf '%s\n' '[packet-return-metrics]'
/usr/bin/timeout 5 /usr/bin/curl --fail --silent --show-error http://127.0.0.1:9090/metrics 2>&1 |
  /usr/bin/awk '
    BEGIN {
      allowed["geneve_rx_packets"] = 1
      allowed["geneve_rx_bytes"] = 1
      allowed["geneve_tx_packets"] = 1
      allowed["geneve_tx_bytes"] = 1
      allowed["drops"] = 1
      allowed["geneve_options_validation_errors"] = 1
      allowed["gwlb_profile_rejections_total"] = 1
      allowed["gwlb_receive_drops_total"] = 1
      allowed["gwlb_return_build_failures_total"] = 1
      allowed["gwlb_send_failures_total"] = 1
      allowed["gwlb_inner_validation_failures_total"] = 1
      allowed["gwlb_target_ready"] = 1
      allowed["gwlb_target_component_ready"] = 1
      allowed["gwlb_target_readiness_transitions_total"] = 1
      allowed["gwlb_sender_reinitializations_total"] = 1
      allowed["gwlb_mtu_drops_total"] = 1
    }
    {
      metric = ""
      if ($1 == "#" && ($2 == "HELP" || $2 == "TYPE")) {
        metric = $3
      } else if ($1 !~ /^#/) {
        metric = $1
        sub(/\{.*/, "", metric)
      }
      if ((metric in allowed) && emitted < 128) {
        print
        emitted++
      }
    }
  ' || true

printf '%s\n' '[packet-return-routes]'
/usr/bin/timeout 5 /usr/sbin/ip -j -4 route show table main 2>&1 | /usr/bin/head -c 16384 || true
printf '\n'

printf '%s\n' '[packet-return-status]'
/usr/bin/grep -E '^ENVELOPE_(CONFIG_VERSION|MODE|UDP_BIND|MAX_INNER_PACKET_SIZE)=' \
  /etc/envelope/site.env || true
/usr/bin/timeout 5 /usr/bin/curl --fail --silent --show-error http://127.0.0.1:9090/healthz 2>&1 | /usr/bin/head -c 512 || true
printf '\n'
/usr/bin/systemctl show envelope.service --no-pager \
  --property=LoadState,ActiveState,SubState,Result,NRestarts,ExecMainCode,ExecMainStatus 2>&1 |
  /usr/bin/head -c 4096 || true

printf '%s\n' '[bounded-logs]'
/usr/bin/journalctl --no-pager --output=short-iso -n 100 -u envelope.service 2>&1 |
  /usr/bin/head -c 32768 || true
/usr/bin/journalctl --no-pager --output=short-iso -n 100 \
  -u cloud-init.service -u cloud-config.service -u cloud-final.service 2>&1 |
  /usr/bin/head -c 32768 || true
} | /usr/local/sbin/envelope-redact
DIAGNOSTICS
chmod 0755 /usr/local/sbin/envelope-diagnostics

if ! getent group envelope >/dev/null; then groupadd --system envelope; fi
if ! getent passwd envelope >/dev/null; then
  useradd --system --gid envelope --home-dir /nonexistent --shell /sbin/nologin envelope
fi
install -d -o envelope -g envelope -m 0750 /var/log/envelope-target

cat >/etc/systemd/system/envelope.service <<'ENVELOPE_UNIT'
[Unit]
Description=Envelope AWS GWLB packet-return target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=envelope
Group=envelope
EnvironmentFile=/etc/envelope/site.env
EnvironmentFile=/etc/envelope/artifact.env
ExecStartPre=/usr/local/sbin/envelope-preflight
ExecStart=/usr/local/bin/envelope
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
LogsDirectory=envelope-target
LogsDirectoryMode=0750
StandardOutput=append:/var/log/envelope-target/envelope.log
StandardError=append:/var/log/envelope-target/envelope.log

[Install]
WantedBy=multi-user.target
ENVELOPE_UNIT

systemctl daemon-reload
systemctl enable --now envelope.service

printf 'Envelope packet-return bootstrap ready for site=%s artifact=%s revision=%s\n' \
  "$site" "$expected_sha256" "$expected_revision"
