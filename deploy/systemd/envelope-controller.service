[Unit]
Description=Envelope production failover controller
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/envelope-controller
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=exec
User=envelope-controller
Group=envelope-controller
Environment=HOME=/var/lib/envelope-controller
Environment=TMPDIR=/run/envelope-controller
EnvironmentFile=/etc/envelope/controller.env
WorkingDirectory=/var/lib/envelope-controller
ExecStart=/usr/local/bin/envelope-controller
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
OOMPolicy=stop

RuntimeDirectory=envelope-controller
RuntimeDirectoryMode=0700
StateDirectory=envelope-controller
StateDirectoryMode=0700
ReadWritePaths=/run/envelope-controller /var/lib/envelope-controller
ReadOnlyPaths=/etc/envelope
UMask=0077
LimitCORE=0
TasksMax=512

AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes
DevicePolicy=closed
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
KeyringMode=private

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
